(lang dune 3.21)
(pkg enabled)

; dune-project declares the supported range (ocaml >= 5.3.0) for publication;
; the local lock is pinned to the exact toolchain the suite is verified against
; so that `dune build` stays reproducible and does not rebuild a new compiler.
(lock_dir
 (repositories specific-overlay specific-upstream)
 (constraints
  (ocaml (= 5.3.0))))

(repository
 (name specific-overlay)
 (url "git+https://github.com/ocaml-dune/opam-overlays.git#99fc2e18c45b4761ed5f6d282910c03c97e32bce"))

(repository
 (name specific-upstream)
 (url "git+https://github.com/ocaml/opam-repository.git#9c0fb80b783c632ef0024ba0cc86df4ced6c19aa"))
